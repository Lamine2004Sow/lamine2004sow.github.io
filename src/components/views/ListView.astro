---
import MainLayout from '../../layouts/MainLayout.astro';
import Joke from '../Joke.astro';
import { getEntries, type CollectionName } from '../../i18n/content';
import { url } from '../../i18n/paths';
import { ui, type Lang } from '../../i18n/ui';

interface Props {
  collection: CollectionName;
  lang: Lang;
}

const { collection, lang } = Astro.props;
const t = ui[lang];
const entries = await getEntries(collection, lang);
const sectionPath = `/${collection}`;

// Reports show company and duration; the other collections show tags.
const metaOf = (data: { date: string; tags?: string[]; entreprise?: string; duree?: string }) =>
  collection === 'rapports'
    ? [data.entreprise, data.duree, data.date].filter(Boolean)
    : [data.date, ...(data.tags ?? [])];

const jokeText = collection === 'projets' ? t.jokes.projets : undefined;
// Only projects carry a key result.
const resultOf = (data: { result?: string }) => data.result;
---

<MainLayout lang={lang} title={t.nav[collection]}>
  <h1 class="page-title">{t.nav[collection]}</h1>
  <Joke text={jokeText} />
  <p class="lead">{t.intros[collection]}</p>

  <div class="section">
    <ul class="entry-list">
      {entries.map((entry) => (
        <li>
          <a class="entry-title" href={url(lang, `${sectionPath}/${entry.slug}`)}>{entry.data.title}</a>
          <p>{entry.data.description}</p>
          {resultOf(entry.data) && <p class="entry-result">{resultOf(entry.data)}</p>}
          {collection === 'rapports' ? (
            <p class="meta inline-list">
              {metaOf(entry.data).map((item) => <span>{item}</span>)}
            </p>
          ) : (
            <p class="meta">
              {metaOf(entry.data).map((item, i) => (i === 0 ? <span>{item}</span> : <span class="tag">{item}</span>))}
            </p>
          )}
        </li>
      ))}
    </ul>
  </div>
</MainLayout>
