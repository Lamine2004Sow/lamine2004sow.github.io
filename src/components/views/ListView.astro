---
import MainLayout from '../../layouts/MainLayout.astro';
import { getEntries, type CollectionName } from '../../i18n/content';
import { url } from '../../i18n/paths';
import { ui, type Lang } from '../../i18n/ui';

interface Props {
  collection: CollectionName;
  lang: Lang;
}

const { collection, lang } = Astro.props;
const t = ui[lang];
const entries = await getEntries(collection, lang);
const sectionPath = `/${collection}`;

// Reports show company and duration; the other collections show tags.
const metaOf = (data: { date: string; tags?: string[]; entreprise?: string; duree?: string }) =>
  collection === 'rapports'
    ? [data.entreprise, data.duree, data.date].filter(Boolean)
    : [data.date, ...(data.tags ?? [])];
---

<MainLayout lang={lang} title={t.nav[collection]}>
  <h1 class="text-2xl font-bold tracking-tight text-gray-900 sm:text-3xl dark:text-gray-100">{t.nav[collection]}</h1>
  <p class="mt-2 text-gray-500 dark:text-gray-400">{t.intros[collection]}</p>

  <ul class="mt-10 divide-y divide-gray-100 dark:divide-gray-800">
    {entries.map((entry) => (
      <li class="py-5 first:pt-0">
        <a href={url(lang, `${sectionPath}/${entry.slug}`)} class="font-medium text-gray-900 transition-colors hover:text-accent-700 dark:text-gray-100 dark:hover:text-accent-400">{entry.data.title}</a>
        <p class="mt-1">{entry.data.description}</p>
        <p class="mt-2 flex flex-wrap items-center gap-1.5 text-sm text-gray-400 dark:text-gray-500">
          {metaOf(entry.data).map((item, i) => (
            <>
              {i === 0 ? <span>{item}</span> : collection === 'rapports' ? <span>· {item}</span> : <span class="tag">{item}</span>}
            </>
          ))}
        </p>
      </li>
    ))}
  </ul>
</MainLayout>
