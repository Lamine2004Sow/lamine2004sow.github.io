---
import { render } from 'astro:content';
import MainLayout from '../../layouts/MainLayout.astro';
import Joke from '../Joke.astro';
import type { LocalizedEntry, CollectionName } from '../../i18n/content';
import { url } from '../../i18n/paths';
import { ui, type Lang } from '../../i18n/ui';

interface Props {
  collection: CollectionName;
  lang: Lang;
  entry: LocalizedEntry;
}

const { collection, lang, entry } = Astro.props;
const t = ui[lang];
const data = entry.data as {
  title: string;
  description: string;
  date: string;
  tags?: string[];
  entreprise?: string;
  duree?: string;
  github?: string;
  demo?: string;
  result?: string;
  joke?: string;
};
const { Content } = await render(entry);

const meta =
  collection === 'rapports'
    ? [data.entreprise, data.duree, data.date].filter(Boolean)
    : [data.date, ...(data.tags ?? [])];
---

<MainLayout lang={lang} title={data.title} description={data.description}>
  <a class="back-link" href={url(lang, `/${collection}`)}>{t.common.back}</a>

  <article>
    <header>
      <h1 class="page-title">{data.title}</h1>
      {collection !== 'rapports' && <Joke text={data.joke} />}
      <p class="lead">{data.description}</p>
      {data.result && <p class="entry-result">{data.result}</p>}
      <p class="meta inline-list">
        {meta.map((item) => <span>{item}</span>)}
      </p>
      {(data.github || data.demo) && (
        <p class="inline-list">
          {data.github && (
            <a href={data.github} target="_blank" rel="noopener">{t.common.codeLink}</a>
          )}
          {data.demo && (
            <a href={data.demo} target="_blank" rel="noopener">{t.common.demoLink}</a>
          )}
        </p>
      )}
    </header>

    <div class="prose section">
      <Content />
    </div>
  </article>
</MainLayout>
