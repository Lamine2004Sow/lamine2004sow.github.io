---
import MainLayout from '../../layouts/MainLayout.astro';
import Joke from '../Joke.astro';
import { getEntries } from '../../i18n/content';
import { url } from '../../i18n/paths';
import { ui, type Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];
const h = t.home;
const projets = await getEntries('projets', lang);
const reportHref = url(lang, '/rapports/rapport-stage-sonatel');
---

<MainLayout lang={lang}>
  <!-- Présentation -->
  <section>
    <h1 class="page-title">{t.common.siteName}</h1>
    <p class="subtitle">{h.subtitle}</p>
    <Joke text={t.jokes.home} />

    <p>{h.intro}</p>
    <p>{h.availability}</p>

    <p class="meta inline-list">
      <a href="mailto:lamine.2004pro.sow@gmail.com">lamine.2004pro.sow@gmail.com</a>
      <a href="https://github.com/Lamine2004Sow" target="_blank" rel="noopener noreferrer">{t.common.github}</a>
      <a href="https://www.linkedin.com/in/mouhamadou-lamine-sow-118097334" target="_blank" rel="noopener noreferrer">{t.common.linkedin}</a>
    </p>

    <p class="meta">
      {t.common.cvLabel}
      <span class="inline-list">
        {t.cvLinks.map((cv) => (
          <span>
            {cv.label} (<span class="inline-list">
              {cv.variants.map((v) => (
                <a href={v.href} target="_blank" rel="noopener">{v.lang}</a>
              ))}
            </span>)
          </span>
        ))}
      </span>
    </p>
  </section>

  <!-- Expérience -->
  <section class="section">
    <h2 class="section-title">{h.sections.experience}</h2>

    {h.experience.map((job) => (
      <div class="job">
        <h3>{job.title}</h3>
        <p class="meta">{job.meta}</p>
        <ul>
          {job.bullets.map((b) => <li>{b}</li>)}
        </ul>
        {job.reportLink && (
          <p class="meta">
            <a href={reportHref}>{t.common.readReport}</a>
          </p>
        )}
      </div>
    ))}
  </section>

  <!-- Projets -->
  <section class="section">
    <h2 class="section-title">{h.sections.projects}</h2>
    <ul class="entry-list">
      {projets.map((projet) => (
        <li>
          <a class="entry-title" href={url(lang, `/projets/${projet.slug}`)}>{projet.data.title}</a>
          <p>{projet.data.description}</p>
          {projet.data.result && <p class="entry-result">{projet.data.result}</p>}
          {projet.data.tags && projet.data.tags.length > 0 && (
            <p>
              {projet.data.tags.map((tag) => <span class="tag">{tag}</span>)}
            </p>
          )}
        </li>
      ))}
    </ul>
    <p class="meta inline-list">
      <a href={url(lang, '/projets')}>{t.common.allProjects}</a>
      <a href={url(lang, '/rapports')}>{t.common.reportLink}</a>
    </p>
  </section>

  <!-- Formation -->
  <section class="section">
    <h2 class="section-title">{h.sections.education}</h2>

    {h.education.map((edu) => (
      <div class="job">
        <h3>{edu.title}</h3>
        <p class="meta">{edu.meta}</p>
        <p>{edu.text}</p>
      </div>
    ))}
  </section>

  <!-- Compétences -->
  <section class="section">
    <h2 class="section-title">{h.sections.skills}</h2>
    <dl class="skills">
      {h.skills.map((s) => (
        <>
          <dt>{s.label}</dt>
          <dd>{s.value}</dd>
        </>
      ))}
    </dl>
  </section>

  <!-- Langues & certification -->
  <section class="section">
    <h2 class="section-title">{h.sections.languages}</h2>
    <p>{h.languages}</p>
    <p>{h.certification}</p>
  </section>
</MainLayout>
