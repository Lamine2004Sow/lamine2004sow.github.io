---
import MainLayout from '../../layouts/MainLayout.astro';
import { getEntries } from '../../i18n/content';
import { url } from '../../i18n/paths';
import { ui, type Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];
const h = t.home;
const projets = await getEntries('projets', lang);
const redactions = await getEntries('redactions', lang);
const reportHref = url(lang, '/rapports/rapport-stage-sonatel');
---

<MainLayout lang={lang}>
  <!-- Présentation -->
  <section>
    <h1 class="text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl dark:text-gray-100">{t.common.siteName}</h1>
    <p class="mt-2 text-base text-accent-700 dark:text-accent-400">{h.subtitle}</p>

    <p class="mt-6 leading-relaxed">{h.intro}</p>
    <p class="mt-4">{h.availability}</p>

    <p class="mt-4 flex flex-wrap gap-x-2 gap-y-1 text-sm">
      <a href="mailto:lamine.2004pro.sow@gmail.com" class="link">lamine.2004pro.sow@gmail.com</a>
      <span class="text-gray-300 dark:text-gray-600">·</span>
      <a href="https://github.com/Lamine2004Sow" target="_blank" rel="noopener noreferrer" class="link">{t.common.github}</a>
      <span class="text-gray-300 dark:text-gray-600">·</span>
      <a href="https://www.linkedin.com/in/mouhamadou-lamine-sow-118097334" target="_blank" rel="noopener noreferrer" class="link">{t.common.linkedin}</a>
    </p>

    <p class="mt-4 flex flex-wrap gap-x-2 gap-y-1 text-sm">
      <span class="text-gray-500 dark:text-gray-400">{t.common.cvLabel}</span>
      {t.cvLinks.map((cv, i) => (
        <>
          {i > 0 && <span class="text-gray-300 dark:text-gray-600">·</span>}
          <span>
            <span class="text-gray-700 dark:text-gray-300">{cv.label}</span>
            <span class="text-gray-400 dark:text-gray-500"> (</span>
            {cv.variants.map((v, j) => (
              <>
                {j > 0 && <span class="text-gray-400 dark:text-gray-500"> · </span>}
                <a href={v.href} target="_blank" rel="noopener" class="link">{v.lang}</a>
              </>
            ))}
            <span class="text-gray-400 dark:text-gray-500">)</span>
          </span>
        </>
      ))}
    </p>
  </section>

  <!-- Expérience -->
  <section class="mt-16">
    <h2 class="section-title">{h.sections.experience}</h2>

    {h.experience.map((job, i) => (
      <div class:list={['border-l-2 border-accent-200 pl-5 dark:border-accent-800', i > 0 && 'mt-8']}>
        <h3 class="font-semibold text-gray-900 dark:text-gray-100">{job.title}</h3>
        <p class="text-sm text-gray-500 dark:text-gray-400">{job.meta}</p>
        <ul class="mt-3 list-disc space-y-1.5 pl-5">
          {job.bullets.map((b) => <li>{b}</li>)}
        </ul>
        {job.reportLink && (
          <p class="mt-3 text-sm">
            <a href={reportHref} class="link">{t.common.readReport}</a>
          </p>
        )}
      </div>
    ))}
  </section>

  <!-- Projets -->
  <section class="mt-16">
    <h2 class="section-title">{h.sections.projects}</h2>
    <ul class="divide-y divide-gray-100 dark:divide-gray-800">
      {projets.map((projet) => (
        <li class="py-4 first:pt-0">
          <a href={url(lang, `/projets/${projet.slug}`)} class="font-medium text-gray-900 transition-colors hover:text-accent-700 dark:text-gray-100 dark:hover:text-accent-400">{projet.data.title}</a>
          <p class="mt-1">{projet.data.description}</p>
          {projet.data.tags && projet.data.tags.length > 0 && (
            <p class="mt-2 flex flex-wrap gap-1.5">
              {projet.data.tags.map((tag) => <span class="tag">{tag}</span>)}
            </p>
          )}
        </li>
      ))}
    </ul>
    <p class="mt-5 text-sm">
      <a href={url(lang, '/projets')} class="link">{t.common.allProjects}</a>
    </p>
  </section>

  <!-- Formation -->
  <section class="mt-16">
    <h2 class="section-title">{h.sections.education}</h2>

    {h.education.map((edu, i) => (
      <div class:list={[i > 0 && 'mt-8']}>
        <h3 class="font-semibold text-gray-900 dark:text-gray-100">{edu.title}</h3>
        <p class="text-sm text-gray-500 dark:text-gray-400">{edu.meta}</p>
        <p class="mt-2">{edu.text}</p>
      </div>
    ))}
  </section>

  <!-- Compétences -->
  <section class="mt-16">
    <h2 class="section-title">{h.sections.skills}</h2>
    <dl class="grid gap-y-3 sm:grid-cols-[10rem_1fr] sm:gap-x-6">
      {h.skills.map((s) => (
        <>
          <dt class="font-medium text-accent-800 dark:text-accent-300">{s.label}</dt>
          <dd class="mb-1 sm:mb-0">{s.value}</dd>
        </>
      ))}
    </dl>
  </section>

  <!-- Langues & certification -->
  <section class="mt-16">
    <h2 class="section-title">{h.sections.languages}</h2>
    <p>{h.languages}</p>
    <p class="mt-2">{h.certification}</p>
  </section>

  <!-- Écrits -->
  <section class="mt-16">
    <h2 class="section-title">{h.sections.writing}</h2>
    <ul class="divide-y divide-gray-100 dark:divide-gray-800">
      {redactions.map((article) => (
        <li class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 py-4 first:pt-0">
          <a href={url(lang, `/redactions/${article.slug}`)} class="font-medium text-gray-900 transition-colors hover:text-accent-700 dark:text-gray-100 dark:hover:text-accent-400">{article.data.title}</a>
          <span class="text-sm text-gray-400 dark:text-gray-500">{article.data.date}</span>
        </li>
      ))}
    </ul>
    <p class="mt-5 text-sm">
      <a href={url(lang, '/redactions')} class="link">{t.common.allWriting}</a>
      <span class="mx-2 text-gray-300 dark:text-gray-600">·</span>
      <a href={url(lang, '/rapports')} class="link">{t.common.reportLink}</a>
    </p>
  </section>
</MainLayout>
