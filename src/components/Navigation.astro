---
const { pathname } = Astro.url;

const links = [
  { href: '/', label: 'Accueil' },
  { href: '/cv', label: 'CV & Parcours' },
  { href: '/projets', label: 'Projets' },
  { href: '/redactions', label: 'Rédactions' },
  { href: '/rapports', label: 'Rapports' },
];
---

<nav class="lg:hidden fixed top-0 left-0 right-0 bg-white/95 backdrop-blur-md border-b border-gray-200 z-50">
  <div class="flex items-center justify-between px-4 h-14">
    <a href="/" class="flex items-center gap-2 text-gray-900 font-bold text-sm tracking-tight">
      <span class="w-7 h-7 rounded-lg bg-accent-500 text-white flex items-center justify-center text-xs font-bold">
        MLS
      </span>
      <span>Mouhamadou Lamine SOW</span>
    </a>
    <button
      id="menu-toggle"
      class="text-gray-600 p-2 hover:bg-gray-100 rounded-lg transition-colors"
      aria-label="Menu"
    >
      <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
        <path id="menu-icon" stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
      </svg>
    </button>
  </div>
  <div id="mobile-menu" class="hidden border-t border-gray-200 bg-white px-4 py-3 space-y-1 shadow-lg">
    <ul class="space-y-1">
      {links.map(({ href, label }) => (
        <li>
          <a
            href={href}
            class:list={[
              'block px-3.5 py-2 rounded-lg text-sm font-medium transition-colors',
              (href === '/' ? pathname === '/' : pathname.startsWith(href))
                ? 'bg-accent-50 text-accent-600 font-semibold'
                : 'text-gray-600 hover:bg-gray-100 hover:text-gray-900',
            ]}
          >
            {label}
          </a>
        </li>
      ))}
    </ul>
    <div class="pt-3 mt-2 border-t border-gray-100">
      <a
        href="/Mouhamadou_Lamine_SOW_CV.pdf"
        target="_blank"
        class="flex items-center justify-center gap-2 w-full px-3 py-2 rounded-lg text-xs font-semibold bg-gray-50 border border-gray-200 text-gray-700 hover:bg-accent-50 hover:text-accent-600 transition-colors"
      >
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5M16.5 12 12 16.5m0 0L7.5 12m4.5 4.5V3" />
        </svg>
        Télécharger mon CV (PDF)
      </a>
    </div>
  </div>
</nav>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  toggle?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
  });
</script>
