---
const { pathname } = Astro.url;

const links = [
  { href: '/', label: 'Accueil' },
  { href: '/cv', label: 'CV' },
  { href: '/projets', label: 'Projets' },
  { href: '/redactions', label: 'Rédactions' },
  { href: '/rapports', label: 'Rapports' },
];
---

<nav class="lg:hidden fixed top-0 left-0 right-0 bg-white/95 backdrop-blur-md border-b border-gray-200 z-50">
  <div class="flex items-center justify-between px-4 h-14">
    <a href="/" class="text-gray-900 font-bold text-lg">Votre Nom</a>
    <button
      id="menu-toggle"
      class="text-gray-600 p-2 hover:bg-gray-100 rounded-lg transition-colors"
      aria-label="Menu"
    >
      <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
      </svg>
    </button>
  </div>
  <div id="mobile-menu" class="hidden border-t border-gray-200 bg-white">
    <ul class="p-4 space-y-1">
      {links.map(({ href, label }) => (
        <li>
          <a
            href={href}
            class:list={[
              'block px-4 py-2.5 rounded-lg text-sm font-medium transition-colors',
              (href === '/' ? pathname === '/' : pathname.startsWith(href))
                ? 'bg-accent-50 text-accent-600'
                : 'text-gray-600 hover:bg-gray-100 hover:text-gray-900',
            ]}
          >
            {label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</nav>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  toggle?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
  });
</script>
