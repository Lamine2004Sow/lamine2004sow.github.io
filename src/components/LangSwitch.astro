---
import { url, stripLang } from '../i18n/paths';
import type { Lang } from '../i18n/ui';
import { ui } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const path = stripLang(Astro.url.pathname);
const options: { code: Lang; label: string }[] = [
  { code: 'fr', label: 'FR' },
  { code: 'en', label: 'EN' },
];
---

<nav class="lang-switch" aria-label={ui[lang].common.langSwitch}>
  {
    options.map(({ code, label }, i) => (
      <>
        {i > 0 && <span aria-hidden="true">/</span>}
        <a href={url(code, path)} hreflang={code} lang={code} aria-current={code === lang ? 'true' : undefined}>{label}</a>
      </>
    ))
  }
</nav>
