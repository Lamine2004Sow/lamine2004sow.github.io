---
import { url, stripLang } from '../i18n/paths';
import type { Lang } from '../i18n/ui';
import { ui } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const path = stripLang(Astro.url.pathname);
const options: { code: Lang; label: string }[] = [
  { code: 'fr', label: 'FR' },
  { code: 'en', label: 'EN' },
];
---

<nav aria-label={ui[lang].common.langSwitch} class="inline-flex items-center gap-1 text-sm">
  {options.map(({ code, label }, i) => (
    <>
      {i > 0 && <span class="text-gray-300 dark:text-gray-600" aria-hidden="true">/</span>}
      <a
        href={url(code, path)}
        hreflang={code}
        lang={code}
        aria-current={code === lang ? 'true' : undefined}
        class:list={[
          'rounded px-2 py-0.5 font-medium transition-colors',
          code === lang
            ? 'bg-accent-100 text-accent-800 dark:bg-accent-900/40 dark:text-accent-200'
            : 'text-gray-500 hover:text-accent-700 dark:text-gray-400 dark:hover:text-accent-300',
        ]}
      >
        {label}
      </a>
    </>
  ))}
</nav>
