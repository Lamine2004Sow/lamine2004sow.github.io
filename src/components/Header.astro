---
const path = Astro.url.pathname.replace(/\/$/, '') || '/';

const links = [
  { href: '/projets', label: 'Projets' },
  { href: '/redactions', label: 'Rédactions' },
  { href: '/rapports', label: 'Rapport de stage' },
];

const isActive = (href: string) => path === href || path.startsWith(href + '/');
---

<header class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-3">
  <a href="/" class="font-semibold text-gray-900 hover:text-accent-700 transition-colors">
    Mouhamadou Lamine SOW
  </a>
  <nav aria-label="Navigation principale">
    <ul class="flex flex-wrap gap-x-5 gap-y-1 text-sm">
      {links.map(({ href, label }) => (
        <li>
          <a
            href={href}
            class:list={[
              'transition-colors',
              isActive(href)
                ? 'text-gray-900 font-medium underline underline-offset-4 decoration-accent-600 decoration-2'
                : 'text-gray-500 hover:text-accent-700',
            ]}
            aria-current={isActive(href) ? 'page' : undefined}
          >
            {label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>
