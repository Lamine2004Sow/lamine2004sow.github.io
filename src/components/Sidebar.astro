---
import LangSwitch from './LangSwitch.astro';
import ThemeToggle from './ThemeToggle.astro';
import { normalize, url } from '../i18n/paths';
import { ui, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];
const current = normalize(Astro.url.pathname);

const nav = [
  { href: url(lang, '/'), label: t.nav.home, root: true },
  { href: url(lang, '/projets'), label: t.nav.projets },
  { href: url(lang, '/redactions'), label: t.nav.redactions },
  { href: url(lang, '/rapports'), label: t.nav.rapports },
];

const isActive = (href: string, root?: boolean) => {
  const target = normalize(href);
  if (root) return current === target;
  return current === target || current.startsWith(target + '/');
};
---

<aside
  id="sidebar"
  class="hidden border-b border-gray-200 bg-gray-50 px-6 py-8 lg:fixed lg:inset-y-0 lg:left-0 lg:flex lg:w-72 lg:flex-col lg:overflow-y-auto lg:border-b-0 lg:border-r dark:border-gray-800 dark:bg-gray-900"
>
  <div>
    <a href={url(lang, '/')} class="group flex items-center gap-3">
      <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-accent-600 text-base font-bold text-white">LS</span>
      <span class="font-semibold leading-snug text-gray-900 group-hover:text-accent-700 dark:text-gray-100 dark:group-hover:text-accent-400">
        {t.common.siteName}
      </span>
    </a>
    <p class="mt-4 text-sm leading-snug text-gray-600 dark:text-gray-400">{t.home.subtitle}</p>
    <p class="mt-3 flex items-start gap-2 text-sm text-gray-700 dark:text-gray-300">
      <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-accent-500" aria-hidden="true"></span>
      <span>{t.common.availability}</span>
    </p>

    <nav aria-label={t.common.mainNav} class="mt-8">
      <ul class="space-y-1 text-sm">
        {nav.map(({ href, label, root }) => (
          <li>
            <a
              href={href}
              aria-current={isActive(href, root) ? 'page' : undefined}
              class:list={[
                'block rounded-lg px-3 py-2 transition-colors',
                isActive(href, root)
                  ? 'bg-accent-100 font-medium text-accent-800 dark:bg-accent-900/40 dark:text-accent-200'
                  : 'text-gray-600 hover:bg-gray-100 hover:text-gray-900 dark:text-gray-400 dark:hover:bg-gray-800 dark:hover:text-gray-100',
              ]}
            >
              {label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="mt-8">
      <p class="section-title">{t.common.cv}</p>
      <ul class="space-y-2 text-sm">
        {t.cvLinks.map((cv) => (
          <li class="flex items-baseline justify-between gap-2">
            <span class="text-gray-700 dark:text-gray-300">{cv.label}</span>
            <span class="shrink-0 whitespace-nowrap text-gray-400 dark:text-gray-500">
              {cv.variants.map((v, j) => (
                <>
                  {j > 0 && ' · '}
                  <a href={v.href} target="_blank" rel="noopener" class="link">{v.lang}</a>
                </>
              ))}
            </span>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <div class="mt-auto pt-8">
    <div class="hidden items-center justify-between lg:flex">
      <LangSwitch lang={lang} />
      <ThemeToggle lang={lang} />
    </div>
    <ul class="mt-5 flex flex-wrap gap-x-4 gap-y-2 text-sm">
      <li><a href="mailto:lamine.2004pro.sow@gmail.com" class="link">lamine.2004pro.sow@gmail.com</a></li>
      <li><a href="https://github.com/Lamine2004Sow" target="_blank" rel="noopener noreferrer" class="link">{t.common.github}</a></li>
      <li><a href="https://www.linkedin.com/in/mouhamadou-lamine-sow-118097334" target="_blank" rel="noopener noreferrer" class="link">{t.common.linkedin}</a></li>
    </ul>
  </div>
</aside>
