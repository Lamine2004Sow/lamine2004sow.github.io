---
import MainLayout from '../layouts/MainLayout.astro';

const formations = [
  {
    periode: '09/2024 — Présent',
    titre: 'Cycle d\'Ingénieur en Informatique',
    etablissement: 'Sup Galilée — Université Sorbonne Paris Nord',
    lieu: 'Villetaneuse, France',
    details: [
      'Enseignements scientifiques : Intelligence artificielle, machine learning, recherche opérationnelle et aide à la décision, optimisation combinatoire, algorithmique et complexité, traitement d\'images, fouille de textes, NLP et réseaux de neurones.',
      'Compétences d\'ingénierie : conduite et gestion de projet, conception et développement logiciel, tests unitaires, intégration et déploiement d\'applications, API REST, architectures microservices, conteneurisation et DevOps.',
    ],
  },
];

const experiences = [
  {
    periode: '05/2026 — 07/2026',
    titre: 'Stagiaire Machine Learning Engineer / Data Scientist',
    entreprise: 'ORANGE / SONATEL',
    lieu: 'Dakar, Sénégal',
    missions: [
      'Préparation et analyse de 559 609 observations historiques couvrant 74 267 équipements FTTH, avec création de variables métier, temporelles et géographiques.',
      'Développement d\'un modèle XGBoost multi-horizon à 3, 6, 9 et 12 mois ; scoring de 69 094 PBO sur 954 plaques réseau.',
      'Amélioration du PR-AUC de 0,283 à 0,812 (multiplié par 2,9 par rapport à la règle métier), avec un ROC-AUC de 0,943 à six mois.',
      'Identification de 91 % des saturations, réduction de 88 % des faux négatifs et amélioration de 18,7 % du PR-AUC sur les équipements à occupation intermédiaire.',
      'Calibration isotonique et explicabilité des prédictions avec SHAP (réduction du score de Brier de 63 %), puis production d\'une priorisation géographique pour orienter les investissements réseau.',
    ],
  },
];

const competencesGroupes = [
  {
    categorie: 'Machine Learning & IA',
    description: 'Modélisation statistique, apprentissage supervisé/non-supervisé, deep learning',
    items: [
      'Classification & Régression',
      'Feature Engineering',
      'Calibration isotonique',
      'Explicabilité (SHAP)',
      'Réseaux de neurones & CNN',
      'NLP (Embeddings, Transformers)',
      'Computer Vision',
    ],
  },
  {
    categorie: 'Recherche Opérationnelle & Optimisation',
    description: 'Aide à la décision, modélisation exacte et méthodes approchées',
    items: [
      'Optimisation Combinatoire',
      'PLNE / MILP',
      'Heuristiques & Métaheuristiques',
      'Descente Stochastique & SWAP',
      'Séparation de contraintes & flots',
      'Problème du p-médian & TSP',
      'Knapsack Problem',
    ],
  },
  {
    categorie: 'Technologies & Outils Data / RO',
    description: 'Langages de programmation, frameworks scientifiques et solveurs',
    items: [
      'Python',
      'Julia',
      'SQL',
      'C / C++',
      'Scikit-learn',
      'XGBoost',
      'PyTorch',
      'TensorFlow / Keras',
      'NumPy & Pandas',
      'CPLEX',
      'GUROBI',
      'PuLP & OR-Tools',
    ],
  },
  {
    categorie: 'Ingénierie Logicielle & Environnement',
    description: 'Pratiques de développement, gestion de versions et déploiement',
    items: [
      'Git & GitHub',
      'Linux / Bash',
      'Docker',
      'API REST',
      'Architectures Microservices',
      'CI / CD',
    ],
  },
];
---

<MainLayout title="Curriculum Vitae">
  <div class="px-6 lg:px-14 py-12 max-w-4xl">
    <!-- Header with Download button -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 pb-8 mb-10 border-b border-gray-200">
      <div>
        <h1 class="text-3xl font-extrabold text-gray-900 tracking-tight">Curriculum Vitae</h1>
        <p class="text-sm text-gray-500 mt-1">
          Élève-ingénieur en Informatique · Recherche de stage de fin d'études de 6 mois
        </p>
      </div>
      <a
        href="/Mouhamadou_Lamine_SOW_CV.pdf"
        target="_blank"
        class="inline-flex items-center justify-center gap-2 px-4 py-2.5 bg-accent-500 hover:bg-accent-600 text-white rounded-lg text-sm font-semibold transition-colors shadow-xs shrink-0"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5M16.5 12 12 16.5m0 0L7.5 12m4.5 4.5V3" />
        </svg>
        Télécharger mon CV (PDF)
      </a>
    </div>

    <!-- Profil synthétique -->
    <section class="mb-12 p-6 rounded-xl bg-gray-50 border border-gray-200/80">
      <h2 class="text-xs font-bold uppercase tracking-wider text-accent-700 mb-2">Profil professionnel</h2>
      <p class="text-sm text-gray-700 leading-relaxed">
        Élève-ingénieur en dernière année à Sup Galilée, je recherche un stage de fin d’études de 6 mois en intelligence artificielle et recherche opérationnelle. J’applique le machine learning et l’optimisation combinatoire à des problématiques concrètes d’aide à la décision, avec une solide expérience en prédiction multi-horizon, explicabilité des modèles et modélisation PLNE. Je développe également mes compétences en NLP et computer vision à travers des projets pratiques en deep learning.
      </p>
      <div class="mt-4 pt-3 border-t border-gray-200/60 flex flex-wrap gap-4 text-xs text-gray-600">
        <div><strong>Localisation :</strong> Paris, France</div>
        <div><strong>Email :</strong> <a href="mailto:lamine.2004pro.sow@gmail.com" class="text-accent-600 hover:underline">lamine.2004pro.sow@gmail.com</a></div>
        <div><strong>GitHub :</strong> <a href="https://github.com/Lamine2004Sow" target="_blank" class="text-accent-600 hover:underline">github.com/Lamine2004Sow</a></div>
      </div>
    </section>

    <!-- Expériences Professionnelles -->
    <section class="mb-14">
      <h2 class="text-xs font-bold uppercase tracking-wider text-accent-700 mb-6 flex items-center gap-2">
        <span>Expérience Professionnelle</span>
        <span class="h-px bg-gray-200 flex-1"></span>
      </h2>

      <div class="space-y-8">
        {experiences.map((exp) => (
          <div class="relative pl-6 border-l-2 border-accent-300">
            <div class="absolute -left-[5px] top-1.5 w-2 h-2 rounded-full bg-accent-500 ring-4 ring-white"></div>
            <div class="flex flex-wrap items-baseline justify-between gap-2">
              <h3 class="text-base font-bold text-gray-900">{exp.titre}</h3>
              <span class="text-xs font-mono font-medium text-gray-500 bg-gray-100 px-2 py-0.5 rounded">{exp.periode}</span>
            </div>
            <div class="text-xs font-semibold text-accent-600 mt-0.5">
              {exp.entreprise} · <span class="text-gray-500 font-normal">{exp.lieu}</span>
            </div>
            <ul class="mt-3 space-y-2 text-xs sm:text-sm text-gray-600 list-disc pl-4 leading-relaxed">
              {exp.missions.map((m) => (
                <li>{m}</li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <!-- Formation Académique -->
    <section class="mb-14">
      <h2 class="text-xs font-bold uppercase tracking-wider text-accent-700 mb-6 flex items-center gap-2">
        <span>Formation Académique</span>
        <span class="h-px bg-gray-200 flex-1"></span>
      </h2>

      <div class="space-y-8">
        {formations.map((f) => (
          <div class="relative pl-6 border-l-2 border-gray-200">
            <div class="absolute -left-[5px] top-1.5 w-2 h-2 rounded-full bg-gray-400 ring-4 ring-white"></div>
            <div class="flex flex-wrap items-baseline justify-between gap-2">
              <h3 class="text-base font-bold text-gray-900">{f.titre}</h3>
              <span class="text-xs font-mono font-medium text-gray-500 bg-gray-100 px-2 py-0.5 rounded">{f.periode}</span>
            </div>
            <div class="text-xs font-semibold text-gray-700 mt-0.5">
              {f.etablissement} · <span class="text-gray-500 font-normal">{f.lieu}</span>
            </div>
            <div class="mt-3 space-y-1.5 text-xs sm:text-sm text-gray-600 leading-relaxed">
              {f.details.map((d) => (
                <p>{d}</p>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Compétences Techniques -->
    <section class="mb-14">
      <h2 class="text-xs font-bold uppercase tracking-wider text-accent-700 mb-6 flex items-center gap-2">
        <span>Compétences</span>
        <span class="h-px bg-gray-200 flex-1"></span>
      </h2>

      <div class="grid gap-4 sm:grid-cols-2">
        {competencesGroupes.map((grp) => (
          <div class="p-5 bg-white border border-gray-200 rounded-xl shadow-xs">
            <h3 class="text-sm font-bold text-gray-900">{grp.categorie}</h3>
            <p class="text-xs text-gray-500 mt-0.5 mb-3">{grp.description}</p>
            <div class="flex flex-wrap gap-1.5">
              {grp.items.map((item) => (
                <span class="px-2.5 py-1 text-xs font-medium bg-gray-100 text-gray-700 rounded-md">
                  {item}
                </span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Certifications & Langues -->
    <section class="grid sm:grid-cols-2 gap-6 pt-6 border-t border-gray-200">
      <div class="p-5 bg-gray-50/50 border border-gray-200 rounded-xl">
        <h3 class="text-xs font-bold uppercase tracking-wider text-gray-900 mb-3">Certifications</h3>
        <div>
          <div class="text-sm font-semibold text-gray-900">IBM AI Engineering Professional Certificate</div>
          <p class="text-xs text-accent-600 font-medium mt-0.5">IBM / Coursera — En cours (2026)</p>
          <p class="text-xs text-gray-500 mt-1">
            Machine Learning, Deep Learning, PyTorch, TensorFlow, Computer Vision, NLP et Transformers.
          </p>
        </div>
      </div>

      <div class="p-5 bg-gray-50/50 border border-gray-200 rounded-xl">
        <h3 class="text-xs font-bold uppercase tracking-wider text-gray-900 mb-3">Langues</h3>
        <div class="space-y-2 text-sm">
          <div class="flex justify-between">
            <span class="text-gray-700 font-medium">Français</span>
            <span class="text-gray-500 text-xs font-mono">Langue maternelle</span>
          </div>
          <div class="flex justify-between">
            <span class="text-gray-700 font-medium">Anglais</span>
            <span class="text-gray-500 text-xs font-mono">Niveau B2 — TOEIC 802</span>
          </div>
        </div>
      </div>
    </section>
  </div>
</MainLayout>
