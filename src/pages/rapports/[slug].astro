---
import MainLayout from '../../layouts/MainLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const rapports = await getCollection('rapports');
  return rapports.map((rapport) => ({
    params: { slug: rapport.id },
    props: { rapport },
  }));
}

const { rapport } = Astro.props;
const { Content } = await render(rapport);
const meta = [rapport.data.entreprise, rapport.data.duree, rapport.data.date].filter(Boolean).join(' · ');
---

<MainLayout title={rapport.data.title} description={rapport.data.description}>
  <a href="/rapports" class="text-sm text-gray-500 hover:text-accent-700 transition-colors">← Retour</a>

  <article class="mt-8">
    <header>
      <h1 class="text-2xl sm:text-3xl font-bold text-gray-900 tracking-tight">{rapport.data.title}</h1>
      <p class="mt-3">{rapport.data.description}</p>
      <p class="mt-2 text-sm text-gray-400">{meta}</p>
    </header>

    <div class="prose mt-10">
      <Content />
    </div>
  </article>
</MainLayout>
