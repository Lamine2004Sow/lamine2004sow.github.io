---
import MainLayout from '../../layouts/MainLayout.astro';
import { getCollection } from 'astro:content';

const rapports = (await getCollection('rapports')).sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);
---

<MainLayout title="Rapport de stage">
  <h1 class="text-2xl font-bold text-gray-900 tracking-tight">Rapport de stage</h1>
  <p class="mt-2">Rapports issus de mes stages.</p>

  <ul class="mt-10 divide-y divide-gray-100">
    {rapports.map((rapport) => (
      <li class="py-5 first:pt-0">
        <a href={`/rapports/${rapport.id}`} class="font-medium text-gray-900 hover:text-accent-700 transition-colors">{rapport.data.title}</a>
        <p class="mt-1">{rapport.data.description}</p>
        <p class="mt-1 text-sm text-gray-400">
          {[rapport.data.entreprise, rapport.data.duree, rapport.data.date].filter(Boolean).join(' · ')}
        </p>
      </li>
    ))}
  </ul>
</MainLayout>
