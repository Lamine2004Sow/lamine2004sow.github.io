---
import MainLayout from '../../layouts/MainLayout.astro';
import { getCollection } from 'astro:content';

const redactions = (await getCollection('redactions')).sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);
---

<MainLayout title="Rédactions">
  <h1 class="text-2xl font-bold text-gray-900 tracking-tight">Rédactions</h1>
  <p class="mt-2">Articles et notes techniques.</p>

  <ul class="mt-10 divide-y divide-gray-100">
    {redactions.map((article) => (
      <li class="py-5 first:pt-0">
        <a href={`/redactions/${article.id}`} class="font-medium text-gray-900 hover:text-accent-700 transition-colors">{article.data.title}</a>
        <p class="mt-1">{article.data.description}</p>
        <p class="mt-1 text-sm text-gray-400">
          {[article.data.date, ...(article.data.tags ?? [])].join(' · ')}
        </p>
      </li>
    ))}
  </ul>
</MainLayout>
