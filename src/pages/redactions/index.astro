---
import MainLayout from '../../layouts/MainLayout.astro';
import { getCollection } from 'astro:content';

const redactions = (await getCollection('redactions')).sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);
---

<MainLayout title="Rédactions">
  <div class="px-6 lg:px-12 py-12 max-w-3xl">
    <div class="mb-10">
      <h1 class="text-3xl font-extrabold text-gray-900 mb-2">Rédactions</h1>
      <p class="text-gray-500">Vos articles et réflexions.</p>
    </div>

    <div class="space-y-3">
      {redactions.map((article) => (
        <a href={`/redactions/${article.id}`} class="group flex items-center justify-between p-5 border border-gray-200 rounded-xl hover:border-accent-300 hover:shadow-sm transition-all duration-200">
          <div>
            <h3 class="font-semibold text-gray-900 group-hover:text-accent-600 transition-colors">{article.data.title}</h3>
            <p class="text-sm text-gray-400 mt-1">{article.data.description}</p>
          </div>
          <span class="text-xs text-gray-400 whitespace-nowrap ml-4 font-mono">{article.data.date}</span>
        </a>
      ))}
    </div>
  </div>
</MainLayout>
