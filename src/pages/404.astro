---
import MainLayout from '../layouts/MainLayout.astro';
import Joke from '../components/Joke.astro';
import { ui } from '../i18n/ui';

// Une seule page pour toutes les langues : GitHub Pages sert /404.html partout.
const fr = ui.fr.notFound;
const en = ui.en.notFound;
---

<MainLayout lang="fr" title={fr.title}>
  <h1 class="page-title">{fr.title}</h1>
  <p class="lead">{fr.text}</p>
  {fr.jokes.map((joke) => <Joke text={joke} />)}
  <p><a href="/">{fr.back}</a></p>

  <section class="section" lang="en">
    <h2>{en.title}</h2>
    <p>{en.text}</p>
    {en.jokes.map((joke) => <Joke text={joke} />)}
    <p><a href="/en/">{en.back}</a></p>
  </section>
</MainLayout>
