---
import MainLayout from '../layouts/MainLayout.astro';
import { getCollection } from 'astro:content';

const projets = (await getCollection('projets')).sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()).slice(0, 3);
const redactions = (await getCollection('redactions')).sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()).slice(0, 3);
---

<MainLayout title="Accueil">
  <!-- Hero -->
  <section class="px-6 lg:px-12 py-16 lg:py-24">
    <div class="max-w-3xl">
      <h1 class="text-4xl lg:text-5xl font-extrabold text-gray-900 leading-tight mb-6">
        Votre titre principal
      </h1>
      <p class="text-lg text-gray-500 leading-relaxed mb-8">
        Votre description ici.
      </p>
      <div class="flex flex-wrap gap-3">
        <a href="/projets" class="inline-flex items-center gap-2 px-5 py-2.5 bg-accent-500 hover:bg-accent-600 text-white rounded-lg font-medium transition-colors text-sm">
          Voir mes projets
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" /></svg>
        </a>
        <a href="/cv" class="inline-flex items-center gap-2 px-5 py-2.5 border border-gray-300 hover:border-gray-400 text-gray-700 rounded-lg font-medium transition-colors text-sm">
          Mon CV
        </a>
      </div>
    </div>
  </section>

  <!-- Derniers projets -->
  <section class="px-6 lg:px-12 py-12 border-t border-gray-100">
    <div class="flex items-center justify-between mb-8">
      <h2 class="text-2xl font-bold text-gray-900">Derniers projets</h2>
      <a href="/projets" class="text-sm text-accent-600 hover:text-accent-500 transition-colors">Voir tout →</a>
    </div>
    <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
      {projets.map((projet) => (
        <a href={`/projets/${projet.id}`} class="group block p-5 bg-white border border-gray-200 rounded-xl hover:border-accent-300 hover:shadow-sm transition-all duration-200">
          <div class="flex items-start justify-between mb-3">
            <h3 class="font-semibold text-gray-900 group-hover:text-accent-600 transition-colors">{projet.data.title}</h3>
            <svg class="w-4 h-4 text-gray-300 group-hover:text-accent-500 transition-colors mt-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 19.5 15-15m0 0H8.25m11.25 0v11.25" /></svg>
          </div>
          <p class="text-sm text-gray-500 mb-3 line-clamp-2">{projet.data.description}</p>
          {projet.data.tags && (
            <div class="flex flex-wrap gap-1.5">
              {projet.data.tags.map((tag: string) => (
                <span class="px-2 py-0.5 text-xs bg-gray-100 text-gray-500 rounded-md">{tag}</span>
              ))}
            </div>
          )}
        </a>
      ))}
    </div>
  </section>

  <!-- Dernières rédactions -->
  <section class="px-6 lg:px-12 py-12 border-t border-gray-100">
    <div class="flex items-center justify-between mb-8">
      <h2 class="text-2xl font-bold text-gray-900">Dernières rédactions</h2>
      <a href="/redactions" class="text-sm text-accent-600 hover:text-accent-500 transition-colors">Voir tout →</a>
    </div>
    <div class="space-y-3">
      {redactions.map((article) => (
        <a href={`/redactions/${article.id}`} class="group flex items-center justify-between p-4 border border-gray-200 rounded-xl hover:border-accent-300 hover:shadow-sm transition-all duration-200">
          <div>
            <h3 class="font-semibold text-gray-900 group-hover:text-accent-600 transition-colors">{article.data.title}</h3>
            <p class="text-sm text-gray-400 mt-1">{article.data.description}</p>
          </div>
          <span class="text-xs text-gray-400 whitespace-nowrap ml-4">{article.data.date}</span>
        </a>
      ))}
    </div>
  </section>
</MainLayout>
