---
import MainLayout from '../layouts/MainLayout.astro';
import { getCollection } from 'astro:content';

const projets = (await getCollection('projets')).sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
const redactions = (await getCollection('redactions')).sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
const rapports = (await getCollection('rapports')).sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
---

<MainLayout title="Accueil">
  <!-- Hero Section -->
  <section class="px-6 lg:px-14 py-14 lg:py-20 border-b border-gray-100">
    <div class="max-w-3xl">
      <!-- Status Badge -->
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-accent-50 border border-accent-200/80 text-accent-700 text-xs font-semibold mb-6 shadow-xs">
        <span class="w-2 h-2 rounded-full bg-accent-500 animate-pulse"></span>
        En recherche d'un stage de fin d'études de 6 mois — IA &amp; Recherche Opérationnelle
      </div>

      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-gray-900 tracking-tight leading-tight mb-6">
        Mouhamadou Lamine SOW
      </h1>

      <p class="text-base sm:text-lg text-gray-600 leading-relaxed mb-6 font-normal">
        Élève-ingénieur en dernière année à <strong class="text-gray-900 font-semibold">Sup Galilée</strong> (Université Sorbonne Paris Nord). 
        J'applique le <strong class="text-gray-900 font-semibold">Machine Learning</strong> et l'<strong class="text-gray-900 font-semibold">Optimisation Combinatoire (PLNE, métaheuristiques)</strong> à la résolution de problématiques concrètes d'aide à la décision industrielle et logistique.
      </p>

      <!-- Key areas pills -->
      <div class="flex flex-wrap gap-2 mb-8">
        <span class="px-3 py-1 text-xs font-medium bg-gray-100 text-gray-700 rounded-md">Machine Learning &amp; Deep Learning</span>
        <span class="px-3 py-1 text-xs font-medium bg-gray-100 text-gray-700 rounded-md">Recherche Opérationnelle (PLNE / MILP)</span>
        <span class="px-3 py-1 text-xs font-medium bg-gray-100 text-gray-700 rounded-md">Métaheuristiques (SWAP, Descente stochastique)</span>
        <span class="px-3 py-1 text-xs font-medium bg-gray-100 text-gray-700 rounded-md">Calibration &amp; Explicabilité (SHAP)</span>
      </div>

      <!-- Action Buttons -->
      <div class="flex flex-wrap items-center gap-3">
        <a 
          href="/projets" 
          class="inline-flex items-center gap-2 px-5 py-2.5 bg-accent-500 hover:bg-accent-600 text-white rounded-lg font-medium text-sm transition-colors shadow-xs"
        >
          Découvrir mes projets
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
          </svg>
        </a>
        <a 
          href="/cv" 
          class="inline-flex items-center gap-2 px-5 py-2.5 bg-white border border-gray-300 hover:border-gray-400 text-gray-700 hover:text-gray-900 rounded-lg font-medium text-sm transition-colors shadow-xs"
        >
          Consulter mon parcours
        </a>
        <a 
          href="/Mouhamadou_Lamine_SOW_CV.pdf" 
          target="_blank"
          class="inline-flex items-center gap-2 px-4 py-2.5 text-gray-500 hover:text-accent-600 rounded-lg font-medium text-sm transition-colors"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5M16.5 12 12 16.5m0 0L7.5 12m4.5 4.5V3" />
          </svg>
          CV (PDF)
        </a>
      </div>
    </div>
  </section>

  <!-- Highlight metrics -->
  <section class="px-6 lg:px-14 py-10 bg-gray-50/50 border-b border-gray-200">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-6 max-w-4xl">
      <div>
        <div class="text-2xl lg:text-3xl font-extrabold text-accent-600 font-mono">x2,9</div>
        <p class="text-xs text-gray-500 mt-1">PR-AUC vs règle métier (Stage Sonatel FTTH)</p>
      </div>
      <div>
        <div class="text-2xl lg:text-3xl font-extrabold text-gray-900 font-mono">0,084 s</div>
        <p class="text-xs text-gray-500 mt-1">Convergence métaheuristique Ring-Star</p>
      </div>
      <div>
        <div class="text-2xl lg:text-3xl font-extrabold text-gray-900 font-mono">91 %</div>
        <p class="text-xs text-gray-500 mt-1">Rappel sur les saturations d'équipements</p>
      </div>
      <div>
        <div class="text-2xl lg:text-3xl font-extrabold text-accent-600 font-mono">-63 %</div>
        <p class="text-xs text-gray-500 mt-1">Score de Brier via calibration isotonique</p>
      </div>
    </div>
  </section>

  <!-- Projets Section -->
  <section class="px-6 lg:px-14 py-12 border-b border-gray-100">
    <div class="flex items-center justify-between mb-8 max-w-4xl">
      <div>
        <h2 class="text-xl font-bold text-gray-900">Projets phares</h2>
        <p class="text-xs text-gray-500 mt-0.5">Optimisation mathématique et modélisation prédictive</p>
      </div>
      <a href="/projets" class="text-sm font-semibold text-accent-600 hover:text-accent-700 transition-colors inline-flex items-center gap-1">
        Voir tous les projets <span aria-hidden="true">→</span>
      </a>
    </div>

    <div class="grid gap-5 md:grid-cols-2 max-w-4xl">
      {projets.map((projet) => (
        <a 
          href={`/projets/${projet.id}`} 
          class="group block p-6 bg-white border border-gray-200 rounded-xl hover:border-accent-400 hover:shadow-sm transition-all duration-200"
        >
          <div class="flex items-start justify-between gap-3 mb-3">
            <h3 class="text-base font-bold text-gray-900 group-hover:text-accent-600 transition-colors leading-snug">
              {projet.data.title}
            </h3>
            <svg class="w-4 h-4 text-gray-400 group-hover:text-accent-500 transition-colors mt-1 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 19.5 15-15m0 0H8.25m11.25 0v11.25" />
            </svg>
          </div>
          <p class="text-sm text-gray-600 mb-4 line-clamp-2 leading-relaxed">
            {projet.data.description}
          </p>
          <div class="flex flex-wrap items-center gap-1.5">
            {projet.data.tags && projet.data.tags.slice(0, 4).map((tag: string) => (
              <span class="px-2.5 py-0.5 text-[11px] font-medium bg-gray-100 text-gray-600 rounded-md">
                {tag}
              </span>
            ))}
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- Rédactions & Rapports -->
  <section class="px-6 lg:px-14 py-12">
    <div class="grid md:grid-cols-2 gap-10 max-w-4xl">
      <!-- Rédactions -->
      <div>
        <div class="flex items-center justify-between mb-6">
          <h2 class="text-lg font-bold text-gray-900">Rédactions techniques</h2>
          <a href="/redactions" class="text-xs font-semibold text-accent-600 hover:text-accent-700 transition-colors">
            Voir tout →
          </a>
        </div>
        <div class="space-y-3">
          {redactions.map((art) => (
            <a 
              href={`/redactions/${art.id}`} 
              class="group block p-4 rounded-lg border border-gray-200 hover:border-accent-300 hover:bg-gray-50/50 transition-all"
            >
              <h3 class="text-sm font-semibold text-gray-900 group-hover:text-accent-600 transition-colors leading-snug">
                {art.data.title}
              </h3>
              <p class="text-xs text-gray-500 mt-1 line-clamp-2">
                {art.data.description}
              </p>
              <div class="mt-2 text-[11px] font-mono text-gray-400">
                {art.data.date}
              </div>
            </a>
          ))}
        </div>
      </div>

      <!-- Rapports de stage -->
      <div>
        <div class="flex items-center justify-between mb-6">
          <h2 class="text-lg font-bold text-gray-900">Expérience &amp; Rapports</h2>
          <a href="/rapports" class="text-xs font-semibold text-accent-600 hover:text-accent-700 transition-colors">
            Voir tout →
          </a>
        </div>
        <div class="space-y-3">
          {rapports.map((rap) => (
            <a 
              href={`/rapports/${rap.id}`} 
              class="group block p-4 rounded-lg border border-gray-200 hover:border-accent-300 hover:bg-gray-50/50 transition-all"
            >
              <span class="inline-block px-2 py-0.5 text-[10px] font-semibold bg-accent-50 text-accent-700 rounded mb-1.5">
                {rap.data.entreprise || "Stage"}
              </span>
              <h3 class="text-sm font-semibold text-gray-900 group-hover:text-accent-600 transition-colors leading-snug">
                {rap.data.title}
              </h3>
              <p class="text-xs text-gray-500 mt-1 line-clamp-2">
                {rap.data.description}
              </p>
              <div class="mt-2 text-[11px] font-mono text-gray-400">
                {rap.data.duree} · {rap.data.date}
              </div>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>
</MainLayout>
