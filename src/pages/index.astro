---
import MainLayout from '../layouts/MainLayout.astro';
import { getCollection } from 'astro:content';

const byDateDesc = <T extends { data: { date: string } }>(a: T, b: T) =>
  new Date(b.data.date).getTime() - new Date(a.data.date).getTime();

const projets = (await getCollection('projets')).sort(byDateDesc);
const redactions = (await getCollection('redactions')).sort(byDateDesc);

const cvLinks = [
  { label: 'Machine learning', variants: [['FR', '/cv/cv-ml-fr.pdf'], ['EN', '/cv/cv-ml-en.pdf']] },
  { label: 'Recherche opérationnelle', variants: [['FR', '/cv/cv-ro-fr.pdf'], ['EN', '/cv/cv-ro-en.pdf']] },
];

const competences = [
  { label: 'Langages', value: 'Python, SQL, C/C++, Julia' },
  { label: 'Machine learning', value: 'PyTorch, scikit-learn, XGBoost, pandas, NumPy ; vision par ordinateur, NLP, classification déséquilibrée' },
  { label: 'Optimisation', value: 'PLNE, Gurobi, CPLEX, CBC, PuLP ; métaheuristiques, recherche locale' },
  { label: 'Évaluation', value: 'validation croisée et temporelle, calibration, interprétabilité (SHAP)' },
  { label: 'Outils', value: 'Git, Linux, pytest, Jupyter' },
];

const h2 = 'text-sm font-semibold uppercase tracking-wide text-gray-900 mb-5';
const meta = 'text-sm text-gray-500';
---

<MainLayout>
  <!-- Présentation -->
  <section>
    <h1 class="text-3xl sm:text-4xl font-bold text-gray-900 tracking-tight">Mouhamadou Lamine SOW</h1>
    <p class="mt-2 text-base text-gray-500">Élève-ingénieur informatique — Machine learning et recherche opérationnelle</p>

    <p class="mt-6 leading-relaxed">
      Élève-ingénieur en dernière année à Sup Galilée (Université Sorbonne Paris Nord), à l’interface du machine learning et de la recherche opérationnelle. Expérience en data science chez Sonatel (groupe Orange) et projets en vision par ordinateur et en optimisation, menés avec une évaluation rigoureuse et un code reproductible.
    </p>
    <p class="mt-4">Disponible pour un stage de fin d’études de 6 mois dès mars 2027.</p>

    <p class="mt-4 text-sm flex flex-wrap gap-x-2 gap-y-1">
      <a href="mailto:lamine.2004pro.sow@gmail.com">lamine.2004pro.sow@gmail.com</a>
      <span class="text-gray-300">·</span>
      <a href="https://github.com/Lamine2004Sow" target="_blank" rel="noopener noreferrer">GitHub</a>
      <span class="text-gray-300">·</span>
      <a href="https://www.linkedin.com/in/mouhamadou-lamine-sow-118097334" target="_blank" rel="noopener noreferrer">LinkedIn</a>
    </p>

    <p class="mt-4 text-sm flex flex-wrap gap-x-2 gap-y-1">
      <span class="text-gray-500">CV :</span>
      {cvLinks.map((cv, i) => (
        <>
          {i > 0 && <span class="text-gray-300">·</span>}
          <span>
            <a href={cv.variants[0][1]} target="_blank" rel="noopener">{cv.label}</a>
            <span class="text-gray-400"> (</span>
            {cv.variants.map(([lang, href], j) => (
              <>
                {j > 0 && <span class="text-gray-400"> · </span>}
                <a href={href} target="_blank" rel="noopener">{lang}</a>
              </>
            ))}
            <span class="text-gray-400">)</span>
          </span>
        </>
      ))}
    </p>
  </section>

  <!-- Expérience -->
  <section class="mt-16">
    <h2 class={h2}>Expérience</h2>

    <div>
      <h3 class="font-semibold text-gray-900">Stage Machine Learning / Data Science</h3>
      <p class={meta}>Sonatel (groupe Orange), Dakar, Sénégal — 05/2026 – 07/2026</p>
      <ul class="mt-3 list-disc pl-5 space-y-1.5">
        <li>Modèle XGBoost de prédiction des risques de saturation à 6 mois : 88 % de faux négatifs en moins que la règle métier en place (PR-AUC 0,81 contre 0,28).</li>
        <li>Construction, en binôme, d’un historique du réseau fibre sur 8 ans (2018–2026) ; variables temporelles et géographiques, évaluation chronologique sans fuite de données.</li>
        <li>Calibration des probabilités et explication des prédictions (SHAP) ; extension à 4 horizons de 3 à 12 mois et cartographie des risques par zone pour la planification réseau.</li>
      </ul>
      <p class="mt-3 text-sm">
        <a href="/rapports/rapport-stage-sonatel">Lire le rapport de stage →</a>
      </p>
    </div>

    <div class="mt-8">
      <h3 class="font-semibold text-gray-900">Stage d’observation — Numérique et DevOps</h3>
      <p class={meta}>Sonatel (groupe Orange), Dakar — 07/2024 – 09/2024</p>
      <ul class="mt-3 list-disc pl-5 space-y-1.5">
        <li>État de l’art sur l’automatisation intelligente du DevOps ; initiation à Angular, LoopBack et MongoDB.</li>
      </ul>
    </div>
  </section>

  <!-- Projets -->
  <section class="mt-16">
    <h2 class={h2}>Projets</h2>
    <ul class="divide-y divide-gray-100">
      {projets.map((projet) => (
        <li class="py-4 first:pt-0">
          <a href={`/projets/${projet.id}`} class="font-medium text-gray-900 hover:text-accent-700 transition-colors">{projet.data.title}</a>
          <p class="mt-1">{projet.data.description}</p>
          {projet.data.tags && projet.data.tags.length > 0 && (
            <p class="mt-1 text-sm text-gray-400">{projet.data.tags.join(' · ')}</p>
          )}
        </li>
      ))}
    </ul>
    <p class="mt-5 text-sm">
      <a href="/projets">Tous les projets →</a>
    </p>
  </section>

  <!-- Formation -->
  <section class="mt-16">
    <h2 class={h2}>Formation</h2>

    <div>
      <h3 class="font-semibold text-gray-900">Diplôme d’ingénieur en informatique (Bac+5, prévu en 2027)</h3>
      <p class={meta}>Sup Galilée, Université Sorbonne Paris Nord, Villetaneuse — 09/2024 – aujourd’hui</p>
      <p class="mt-2">Cours clés : machine learning, deep learning, NLP et Transformers, recherche opérationnelle, optimisation combinatoire, génie logiciel.</p>
    </div>

    <div class="mt-8">
      <h3 class="font-semibold text-gray-900">Cycle préparatoire intégré (CPI) — MPSI</h3>
      <p class={meta}>ESIGELEC–ESMT, Dakar — 09/2022 – 05/2024</p>
      <p class="mt-2">Mathématiques, physique et sciences de l’ingénieur.</p>
    </div>
  </section>

  <!-- Compétences -->
  <section class="mt-16">
    <h2 class={h2}>Compétences</h2>
    <dl class="grid gap-y-3 sm:grid-cols-[10rem_1fr] sm:gap-x-6">
      {competences.map((c) => (
        <>
          <dt class="font-medium text-gray-900">{c.label}</dt>
          <dd class="mb-1 sm:mb-0">{c.value}</dd>
        </>
      ))}
    </dl>
  </section>

  <!-- Langues & certification -->
  <section class="mt-16">
    <h2 class={h2}>Langues &amp; certification</h2>
    <p>Français : langue maternelle · Anglais : B2 (TOEIC 802)</p>
    <p class="mt-2">IBM AI Engineering Professional Certificate — IBM / Coursera, en cours (2026)</p>
  </section>

  <!-- Écrits -->
  <section class="mt-16">
    <h2 class={h2}>Écrits</h2>
    <ul class="divide-y divide-gray-100">
      {redactions.map((article) => (
        <li class="py-4 first:pt-0 flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
          <a href={`/redactions/${article.id}`} class="font-medium text-gray-900 hover:text-accent-700 transition-colors">{article.data.title}</a>
          <span class="text-sm text-gray-400">{article.data.date}</span>
        </li>
      ))}
    </ul>
    <p class="mt-5 text-sm">
      <a href="/redactions">Toutes les rédactions →</a>
      <span class="text-gray-300 mx-2">·</span>
      <a href="/rapports">Rapport de stage →</a>
    </p>
  </section>
</MainLayout>
