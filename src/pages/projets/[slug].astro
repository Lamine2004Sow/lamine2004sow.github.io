---
import MainLayout from '../../layouts/MainLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const projets = await getCollection('projets');
  return projets.map((projet) => ({
    params: { slug: projet.id },
    props: { projet },
  }));
}

const { projet } = Astro.props;
const { Content } = await render(projet);
const meta = [projet.data.date, ...(projet.data.tags ?? [])].join(' · ');
---

<MainLayout title={projet.data.title} description={projet.data.description}>
  <a href="/projets" class="text-sm text-gray-500 hover:text-accent-700 transition-colors">← Retour</a>

  <article class="mt-8">
    <header>
      <h1 class="text-2xl sm:text-3xl font-bold text-gray-900 tracking-tight">{projet.data.title}</h1>
      <p class="mt-3">{projet.data.description}</p>
      <p class="mt-2 text-sm text-gray-400">{meta}</p>
      {(projet.data.github || projet.data.demo) && (
        <p class="mt-3 text-sm flex gap-4">
          {projet.data.github && (
            <a href={projet.data.github} target="_blank" rel="noopener">GitHub ↗</a>
          )}
          {projet.data.demo && (
            <a href={projet.data.demo} target="_blank" rel="noopener">Démo ↗</a>
          )}
        </p>
      )}
    </header>

    <div class="prose mt-10">
      <Content />
    </div>
  </article>
</MainLayout>
