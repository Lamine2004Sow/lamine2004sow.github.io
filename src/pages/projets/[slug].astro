---
import EntryView from '../../components/views/EntryView.astro';
import { getEntries } from '../../i18n/content';

export async function getStaticPaths() {
  const entries = await getEntries('projets', 'fr');
  return entries.map((entry) => ({ params: { slug: entry.slug }, props: { entry } }));
}

const { entry } = Astro.props;
---

<EntryView collection="projets" lang="fr" entry={entry} />
