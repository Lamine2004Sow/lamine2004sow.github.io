---
import MainLayout from '../../layouts/MainLayout.astro';
import { getCollection } from 'astro:content';

const projets = (await getCollection('projets')).sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);
---

<MainLayout title="Projets">
  <h1 class="text-2xl font-bold text-gray-900 tracking-tight">Projets</h1>
  <p class="mt-2">Projets de machine learning et d’optimisation.</p>

  <ul class="mt-10 divide-y divide-gray-100">
    {projets.map((projet) => (
      <li class="py-5 first:pt-0">
        <a href={`/projets/${projet.id}`} class="font-medium text-gray-900 hover:text-accent-700 transition-colors">{projet.data.title}</a>
        <p class="mt-1">{projet.data.description}</p>
        <p class="mt-1 text-sm text-gray-400">
          {[projet.data.date, ...(projet.data.tags ?? [])].join(' · ')}
        </p>
      </li>
    ))}
  </ul>
</MainLayout>
