---
import Header from '../components/Header.astro';

interface Props {
  title?: string;
  description?: string;
}

const DEFAULT_DESCRIPTION =
  'Mouhamadou Lamine SOW — élève-ingénieur informatique, machine learning et recherche opérationnelle.';

const { title, description = DEFAULT_DESCRIPTION } = Astro.props;
const pageTitle = title ? `${title} — Mouhamadou Lamine SOW` : 'Mouhamadou Lamine SOW';
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <title>{pageTitle}</title>
  </head>
  <body class="bg-white text-gray-600 antialiased selection:bg-accent-100 selection:text-accent-900">
    <div class="mx-auto max-w-2xl px-5 py-10 sm:py-16">
      <Header />

      <main class="mt-14 sm:mt-20">
        <slot />
      </main>

      <footer class="mt-20 pt-6 border-t border-gray-100 text-sm text-gray-400 flex flex-wrap gap-x-4 gap-y-2">
        <a href="mailto:lamine.2004pro.sow@gmail.com" class="hover:text-accent-700 transition-colors">lamine.2004pro.sow@gmail.com</a>
        <a href="https://github.com/Lamine2004Sow" target="_blank" rel="noopener noreferrer" class="hover:text-accent-700 transition-colors">GitHub</a>
        <a href="https://www.linkedin.com/in/mouhamadou-lamine-sow-118097334" target="_blank" rel="noopener noreferrer" class="hover:text-accent-700 transition-colors">LinkedIn</a>
        <span>© 2026</span>
      </footer>
    </div>
  </body>
</html>

<style is:global>
  * {
    scrollbar-width: thin;
    scrollbar-color: #d1d5db transparent;
  }

  ::selection {
    background-color: rgba(37, 99, 235, 0.15);
  }

  .prose {
    @apply text-gray-600 leading-relaxed;
  }

  .prose h1, .prose h2, .prose h3, .prose h4 {
    @apply text-gray-900 font-semibold;
  }

  .prose h1 { @apply text-2xl mt-10 mb-4; }
  .prose h2 { @apply text-xl mt-10 mb-3; }
  .prose h3 { @apply text-lg mt-8 mb-2; }

  .prose p { @apply mb-4; }
  .prose ul, .prose ol { @apply mb-4 pl-6; }
  .prose li { @apply mb-1; }
  .prose ul li { @apply list-disc; }
  .prose ol li { @apply list-decimal; }

  .prose a {
    @apply text-accent-600 underline underline-offset-2 hover:text-accent-700 transition-colors;
  }

  .prose code {
    @apply bg-gray-100 text-gray-800 px-1 py-0.5 rounded text-sm font-mono;
  }

  .prose pre {
    @apply bg-gray-50 border border-gray-200 rounded p-4 mb-4 overflow-x-auto text-sm;
  }

  .prose pre code {
    @apply bg-transparent p-0;
  }

  .prose blockquote {
    @apply border-l-2 border-gray-300 pl-4 text-gray-500 mb-4;
  }

  .prose img {
    @apply rounded my-6;
  }

  /* Tables: scroll horizontally on small screens instead of overflowing the page. */
  .prose table {
    @apply block max-w-full overflow-x-auto mb-4 border-collapse text-sm;
  }

  .prose th, .prose td {
    @apply border border-gray-200 px-3 py-2 text-left align-top;
  }

  .prose th {
    @apply bg-gray-50 font-semibold text-gray-900;
  }
</style>
